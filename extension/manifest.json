{
  "manifest_version": 3,
  "name": "AI Video Fakeness Detector",
  "version": "1.0.0",
  "description": "Detect AI-generated fake videos on YouTube and Facebook using NVIDIA NIM",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.facebook.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/watch*",
        "*://*.youtube.com/shorts/*",
        "*://*.facebook.com/*/videos/*",
        "*://*.facebook.com/reel/*",
        "*://*.facebook.com/watch*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}