{
  "manifest_version": 3,
  "name": "RUAI — is this real?",
  "version": "1.0.0",
  "description": "Checks whether a video was made by AI and whether a message is a scam, and explains the answer in plain words.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/watch*",
        "*://*.youtube.com/shorts/*",
        "*://*.facebook.com/*/videos/*",
        "*://*.facebook.com/reel/*",
        "*://*.facebook.com/watch*"
      ],
      "js": [
        "shared/config.js",
        "shared/api.js",
        "shared/verdict-view.js",
        "content/video-check.js"
      ],
      "css": [
        "styles/tokens.css",
        "styles/ruai.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "shared/config.js",
        "shared/api.js",
        "shared/verdict-view.js",
        "content/message-check.js"
      ],
      "css": [
        "styles/tokens.css",
        "styles/ruai.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "RUAI — is this real?"
  }
}
