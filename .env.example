# ============================================================================
# RUAI configuration
#
#   cp .env.example .env
#
# Every variable the backend reads is listed here with its default. Only
# NIM_API_KEY has to be filled in; everything else works as it stands.
#
# This file carries keys, never values. Never commit a real .env.
# ============================================================================


# --- NVIDIA NIM -------------------------------------------------------------
# Required. Get a free key at https://build.nvidia.com — create an account,
# pick any model, and copy the key from the "Get API Key" panel.
#
# Without it: video and article checks return 503 with a plain-language
# message, and message checks fall back to the local pattern scan and mark
# themselves as degraded. Nothing crashes.
NIM_API_KEY=your_nvidia_nim_api_key_here

NIM_API_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# Reads video frames. Must be a vision-language model.
NIM_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# Reads messages and articles. Small and fast on purpose: a scam warning that
# arrives after the reply has been sent is worth nothing.
NIM_TEXT_MODEL=nvidia/nemotron-nano-9b-v2

NIM_TIMEOUT_SECONDS=60
NIM_MAX_RETRIES=2


# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# Enables debug logging and uvicorn auto-reload.
DEBUG=false

# Origins allowed to call the API, as a JSON array. Any loopback address and
# any Chrome extension are always allowed, so this only matters once RUAI is
# deployed somewhere real.
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]


# --- Analysis ---------------------------------------------------------------
# Longest edge of a frame sent to the model, in pixels. Frames arrive at up to
# 4K; the artefacts that matter survive at 1024 and cost far fewer tokens.
MAX_FRAME_SIZE=1024

# Frames accepted in one video check. Two or more enables the sequence prompt,
# which is where generated video usually gives itself away.
MAX_FRAMES_PER_CHECK=5

# Where a score stops being reassuring and starts being a warning.
#   below CAUTION_THRESHOLD  -> safe
#   between the two          -> caution
#   at or above DANGER       -> danger
CAUTION_THRESHOLD=0.35
DANGER_THRESHOLD=0.70


# --- Local storage ----------------------------------------------------------
# The activity log records what has been checked. It is a list of what someone
# watched and who messaged them, so it stays in a local file, is git-ignored,
# and is never sent anywhere. Ordinary messages are not recorded at all.
# Defaults to backend/data. Set an absolute path if you override it —
# a relative one is resolved against the working directory, which differs
# between `python main.py` and `uvicorn main:app`.
# DATA_DIR=/absolute/path/to/data

ACTIVITY_LOG_ENABLED=true


# --- Web app ----------------------------------------------------------------
# Read by Next.js at build time. Put this in web/.env.local if you prefer.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
