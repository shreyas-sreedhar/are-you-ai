# ---- Secrets -----------------------------------------------------------
# Only .env.example is ever committed. It carries keys, never values.
.env
.env.*
!.env.example

# ---- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node / Next -------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- RUAI runtime data -------------------------------------------------
# The activity log is a local record of what the user has checked. It is
# personal data and must never leave the machine that produced it.
backend/data/
*.csv

# ---- Editors and OS ----------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
